DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_MASTER_NAME=central
# Comma-separated local storefront origins when testing from a phone on the LAN.
STOREFRONT_ALLOWED_ORIGINS=
# Persistent directory for uploaded public store logos (must survive backend restarts/deploys).
STORE_LOGO_DIR=uploads/store-logos
# Persistent legacy directory for product photos; new uploads are stored in R2.
PRODUCT_IMAGE_DIR=uploads/product-images
# Cloudflare R2 S3 API credentials (keep these only on the backend).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional HTTPS public custom domain; leave blank to serve images through the API.
R2_PUBLIC_BASE_URL=
# Optional custom HTTPS S3 endpoint; defaults to the Cloudflare account endpoint.
# R2_ENDPOINT_URL=
# Server key from Midtrans Dashboard > Settings > Access Keys (Sandbox only).
MIDTRANS_SERVER_KEY=
# Keep false for the Sandbox checkout implementation.
MIDTRANS_IS_PRODUCTION=false
# Set Midtrans Sandbox's Payment Notification URL to https://<backend-host>/payments/midtrans/notification.
# Shared AdMob rewarded ad units (reward item "invoice_credit", amount 1) for invoice and product rewards.
ADMOB_REWARDED_AD_UNIT_ID_ANDROID=
ADMOB_REWARDED_AD_UNIT_ID_IOS=
# Set each AdMob rewarded ad's SSV callback URL to https://<backend-host>/ads/rewarded/ssv.
